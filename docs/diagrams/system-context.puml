@startuml system-context
title AI Sandbox - System Context DFD
caption DFD3 context diagram. Optional flows and elements are labeled explicitly.

left to right direction
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor black
hide stereotype
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

' DFD3 external entities: sharp-cornered rectangles.
rectangle "E1\nDeveloper / operator" as E1

' DFD3 trust boundaries: closed dashed boxes.
rectangle "TB1  Host machine" as TB1 <<trust-boundary>> {
  rectangle "P2\nHost Git review, signing,\nand publishing tools" as P2 <<process>>
  database "D1\nShared directory\n~/ai-sandbox-share" as D1
  database "D3\nGit credentials and\nsigning keys" as D3

  rectangle "P3\nHost llama.cpp server\n(optional)" as P3 <<process>>
  database "D4\nLocal model files\n(optional)" as D4

  rectangle "TB2  AI Sandbox NixOS VM" as TB2 <<trust-boundary>> {
    rectangle "P1\nAI Sandbox environment" as P1 <<process>>
    database "D2\nVM virtual disk\nqcow2" as D2
  }
}

rectangle "TB3  External / Internet services" as TB3 <<trust-boundary>> {
  rectangle "E2\nGitHub" as E2
  rectangle "E3\nCloud AI / model services" as E3
  rectangle "E4\nSoftware and package sources\n(Nix caches, npm, vendors)" as E4
  rectangle "E5\nWebsites accessed by\nbrowsers or AI tools" as E5
}

' Processes are rounded rectangles; trust boundaries remain dashed.
skinparam rectangle<<process>> {
  RoundCorner 25
}
skinparam rectangle<<trust-boundary>> {
  BorderStyle dashed
  BackgroundColor transparent
}

' Solid arrows are DFD3 data flows. Bidirectional arrows combine exchanges.
E1 <--> P1 : F1  Keyboard/mouse input and display output\nvia UTM
E1 <--> P1 : F2  Clipboard text\nvia SPICE

P1 <--> D1 : F3  Shared-file reads and writes\n9p/VirtFS
P1 <--> D2 : F4  VM-state reads and writes

P1 <--> E3 : F5  Prompts, context, credentials,\nand model responses - HTTPS
P1 <--> E5 : F6  Browser/tool requests, web content,\nand downloads - HTTP(S)
E4 --> P1 : F7  Software, dependencies,\nand updates - HTTPS
E2 --> P1 : F8  Public source and repository data\nHTTPS or Git transport

P1 <--> P3 : F9  Inference requests and responses (optional)\nOpenAI-compatible HTTP over vmnet
D4 --> P3 : F10  Model and projection files

P2 <--> D1 : F11  Fetches, VM commits, and shared files
P2 <--> E2 : F12  Signed commits and repository data\nSSH or HTTPS
D3 --> P2 : F13  Credentials and signing keys
E1 <--> P2 : F14  Review/publication commands,\ndiffs, status, and results

@enduml
