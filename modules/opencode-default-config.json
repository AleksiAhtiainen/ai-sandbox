{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "plan",

  "model": "llama.cpp/muse-glimmer-local",
  "small_model": "llama.cpp/muse-glimmer-local",

  "autoupdate": false,
  "share": "disabled",

  "enabled_providers": [
    "llama.cpp"
  ],

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",

      "options": {
        "baseURL": "http://192.168.64.1:8080/v1"
      },

      "models": {
        "muse-glimmer-local": {
          "name": "Muse Glimmer (local)",

          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  }
}